<AnchorPane prefHeight="786.0" prefWidth="618.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.orm.controller.UserFormController">
   <Pane layoutX="40.0" layoutY="142.0" prefHeight="200.0" prefWidth="534.0" style="-fx-background-color: #608BC1;" />

    <VBox layoutX="20.0" layoutY="20.0" spacing="10.0">
        <HBox spacing="10" />

        <HBox spacing="10" />
    </VBox>

    <!-- TableView for displaying user data -->
    <TableView fx:id="userTable" layoutX="50.0" layoutY="393.0" prefHeight="170.0" prefWidth="518.0" style="-fx-background-color: gray;">
        <columns>
            <TableColumn fx:id="colId" prefWidth="100.0" text="User ID" />
            <TableColumn fx:id="colUsername" prefWidth="120.00006103515625" text="Username" />
         <TableColumn fx:id="colPassword" prefWidth="123.199951171875" text="Password" />
         <TableColumn fx:id="colPossesion" prefWidth="172.00006103515625" text="Possesion" />
        </columns>
    </TableView>
<!--      <Button fx:id="btnClear" layoutX="508.0" layoutY="593.0" onAction="#btnClearOnAction" prefHeight="26.0" prefWidth="55.0" text="Clear" />-->

     <!-- Buttons -->
     <HBox layoutX="50.0" layoutY="347.0" prefHeight="26.0" prefWidth="186.0" spacing="10" />

     <HBox layoutX="93.0" layoutY="255.0" spacing="10">
         <Label prefHeight="25.0" prefWidth="72.0" text="Password:" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
         <PasswordField fx:id="txtPassword" prefHeight="26.0" prefWidth="177.0" />
     </HBox>

     <HBox layoutX="98.0" layoutY="295.0" prefHeight="26.0" prefWidth="252.0" spacing="10">
         <Label prefHeight="18.0" prefWidth="93.0" text="Possession:" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
         <TextField fx:id="txtPossession" onKeyReleased="#txtPossessionOnKeyReleased" prefHeight="26.0" prefWidth="203.0" />
     </HBox>
      <TextField fx:id="txtUsername" layoutX="176.0" layoutY="218.0" onKeyReleased="#txtUsernameOnKeyReleased" prefHeight="26.0" prefWidth="176.0" />
      <TextField fx:id="txtUserId" layoutX="176.0" layoutY="180.0" prefHeight="26.0" prefWidth="176.0" />
      <Label layoutX="95.0" layoutY="188.0" text="User ID:" textFill="WHITE">
      <font>
         <Font name="System Bold" size="12.0" />
      </font></Label>
      <Label layoutX="94.0" layoutY="224.0" text="Username:" textFill="WHITE">
      <font>
         <Font name="System Bold" size="12.0" />
      </font></Label>
    <Button fx:id="btnSubmit" layoutX="154.0" layoutY="355.0" mnemonicParsing="false" onAction="#btnSubmitOnAction" prefHeight="26.0" prefWidth="75.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Submit" />

    <Button fx:id="btnUpdate" layoutX="231.0" layoutY="355.0" mnemonicParsing="false" onAction="#btnUpdateOnAction" prefHeight="26.0" prefWidth="75.0" style="-fx-background-color: #FF9800; -fx-text-fill: white;" text="Update" />

    <Button fx:id="btnDelete" layoutX="308.0" layoutY="355.0" mnemonicParsing="false" onAction="#btnDeleteOnAction" prefHeight="26.0" prefWidth="75.0" style="-fx-background-color: #F44336; -fx-text-fill: white;" text="Delete" />

    <Button fx:id="btnClear" layoutX="385.0" layoutY="355.0" mnemonicParsing="false" onAction="#btnClearOnAction" prefHeight="26.0" prefWidth="75.0" style="-fx-background-color: #9E9E9E; -fx-text-fill: white;" text="Clear" />

    <Pane layoutX="93.0" layoutY="30.0" prefHeight="58.0" prefWidth="428.0" style="-fx-background-color: #295F98;">
